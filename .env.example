# Binance API credentials
# Get these from https://www.binance.com/en/my/settings/api-management
API_KEY=your_binance_api_key_here
API_SECRET=your_binance_api_secret_here

# Trading configuration
SYMBOL=BTC/USDT          # Token pair to trade
BUY_AMOUNT_USDT=10       # Amount in USDT to spend on each buy
TRADE_INTERVAL=daily     # daily | hourly | custom

# Strategy settings
STRATEGY=ma_crossover    # ma_crossover | rsi | simple_dca
RSI_OVERSOLD=30          # RSI buy threshold
RSI_OVERBOUGHT=70        # RSI sell threshold
MA_SHORT=7               # Short moving average period
MA_LONG=21               # Long moving average period

# DCA (Dollar Cost Averaging) settings
DCA_BUY_TIME=09:00       # Time to buy (UTC)
DCA_SELL_TIME=17:00      # Time to sell (UTC)

# Risk management
STOP_LOSS_PCT=5.0        # Stop loss percentage (e.g., 5.0 = 5%)
TAKE_PROFIT_PCT=10.0     # Take profit percentage

# Exchange
EXCHANGE=binance         # binance | kraken | coinbase | bybit
TESTNET=true             # Use testnet for testing (true/false)

# Logging
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
